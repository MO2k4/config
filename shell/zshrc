# Add autoloadable functions to fpath
fpath=(~/.zsh-functions $fpath)
autoload -Uz grb _git_branch_worktree gfeature gfix gchore gwt _gwt md2pdf _dotnet_zsh_complete gpa

# Source all modules
for conf in ~/.zshrc.d/*.zsh; do
  source "$conf"
done

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# >>> dotnet-mise-migrate >>>
# GUI apps (VS Code from the Dock, etc.) don't inherit the mise shim PATH,
# and /etc/paths.d/dotnet is gone, so point them at the mise root directly.
export DOTNET_ROOT="/Users/martino/.local/share/mise/dotnet-root"
