export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export GPG_TTY=$TTY
export ENABLE_LSP_TOOLS=1

# PATH additions
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="$PATH:$HOME/.dotnet/tools"

# Cargo
export PATH="$HOME/.cargo/bin:$PATH"

# X11
export PATH="/opt/X11/bin:$PATH"
export DISPLAY=:0

# Aspire CLI
export PATH="$HOME/.aspire/bin:$PATH"

# herd hands these to its agents; ais-core init copies .env from here when the worktree came from herd's bare mirror
export AIS_CORE_MAIN_CHECKOUT="$HOME/Work/ais/ais-core"
export HERD_AGENT_ENV="AIS_CORE_MAIN_CHECKOUT"
